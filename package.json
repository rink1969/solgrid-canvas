{
    "name": "solgrid-canvas",
    "private": true,
    "version": "0.1.0",
    "description": "solgrid 平台特化的本地无限画布：daemon + web",
    "scripts": {
        "daemon": "node daemon/server.mjs",
        "smoke": "npm run smoke:store && npm run smoke:runs && npm run smoke:mcp",
        "dev": "npm --prefix web run dev",
        "build": "npm --prefix web run build",
        "mcp": "node daemon/mcp.mjs",
        "doctor": "node bin/solgrid-canvas.mjs doctor",
        "smoke:store": "node daemon/smoke.mjs",
        "smoke:runs": "node daemon/smoke-runs.mjs",
        "smoke:mcp": "node daemon/smoke-mcp.mjs",
        "smoke:agent": "node daemon/smoke-agent.mjs",
        "smoke:video": "node daemon/smoke-video-edit.mjs",
        "start": "node daemon/server.mjs",
        "setup": "node bin/solgrid-canvas.mjs setup"
    },
    "bin": {
        "solgrid-canvas": "bin/solgrid-canvas.mjs"
    }
}
